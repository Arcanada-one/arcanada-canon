                "private_overlay"
              ]
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "required": {
              "const": true
            },
            "valid_from": {
              "type": "integer",
              "minimum": 0
            },
            "expires_at": {
              "type": "integer",
              "minimum": 0
            },
            "access": {
